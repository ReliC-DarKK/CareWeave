# Copy this file to .env and fill in real values for local development.
# Never commit .env — it is gitignored.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# These values must match docker-compose.yml's postgres environment
# variables (POSTGRES_DB / POSTGRES_USER / POSTGRES_PASSWORD) when using
# the bundled Docker Postgres for local development.
POSTGRES_DB=careweave
POSTGRES_USER=careweave
POSTGRES_PASSWORD=change-me-in-local-env
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Prisma reads DATABASE_URL directly. Keep it consistent with the
# POSTGRES_* values above.
DATABASE_URL="postgresql://careweave:change-me-in-local-env@localhost:5432/careweave?schema=public"

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Placeholder for the JWT/session signing secret. Generate a strong random
# value locally (e.g. `openssl rand -base64 48`) — do not use this example
# value anywhere real.
AUTH_JWT_SECRET=replace-with-a-long-random-value
AUTH_JWT_EXPIRES_IN=1h
