{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": [
    "care-logic/**/*.ts",
    "care-state/**/*.ts",
    "next-action/**/*.ts",
    "timeline/**/*.ts",
    "ai/**/*.ts",
    "types/**/*.ts"
  ]
}